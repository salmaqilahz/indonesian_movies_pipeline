# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real secrets.

# TMDb
TMDB_API_KEY=your_tmdb_api_key_here

# Database — leave these blank to use local unix socket peer auth
DB_NAME=film_series_db
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Wikidata etiquette — identifies your bot/script to their servers
WIKIDATA_USER_AGENT=IndonesianFilmPipeline/1.0 (portfolio project)

# Optional: where the IMDb dataset dumps live locally
IMDB_DATA_DIR=./data/imdb
